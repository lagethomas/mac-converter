{
  "manifest_version": 3,
  "name": "MAC Converter Pro",
  "version": "1.1",
  "description": "Conversor profissional de endereços MAC para diversos formatos de rede (Cisco, HP, Linux).",
  "author": "Thomas Marcelino <lage.thomas@gmail.com>",
  "homepage_url": "https://wpmasters.com.br",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir MAC Converter"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}